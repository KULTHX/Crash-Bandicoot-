# Android runtime config for Crash Bandicoot 3: Warped.
# The Android start menu replaces the disc placeholder after the user imports
# their own SCUS-94244 CUE/BIN files.
[game]
name = "Crash Bandicoot 3: Warped"
id = "SCUS-94244"
players = 1
exe = "disc/SCUS_942.44"
discs = [
  @@DISC1@@,
]
disc_serials = ["SCUS-94244"]
load_address = "0x80010000"
entry_pc = "0x800489F8"
text_size = "0x00051000"
stack_base = "0x801FFFF0"

[recompiler]
seeds = "seeds/ghidra_funcs.txt"
out_dir = "generated"
strict = true

[runtime]
# Experimental Android path: use the bundled, redistributable OpenBIOS to
# boot the player's imported disc through the PSX runtime interpreter.
# Enable the framework's OpenBIOS boot-skip so the BIOS animation does not
# remain on screen; execution then continues to the imported disc's game EXE.
# This is still an experimental Crash 3 OpenBIOS path, not a gameplay guarantee.
openbios = true
bios_hle = true
video_renderer = "software"
overlay_cache = true
window_title = "Crash Bandicoot 3: Warped"

[controller]
default_mode = "digital"

[bios]
path = "bios/openbios.bin"
